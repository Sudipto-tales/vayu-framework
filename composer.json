{
    "name": "vayu/framework",
    "description": "Vayu — a lightweight, production-capable PHP micro-framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "workerman/workerman": "Required for the real-time WebSocket server (php vayu websocket)"
    },
    "require-dev": {
        "workerman/workerman": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Vayu\\": "core/",
            "App\\": "app/"
        },
        "files": [
            "core/Support/helpers.php"
        ]
    },
    "bin": [
        "bin/vayu"
    ],
    "scripts": {
        "run": "@php bin/vayu run",
        "test": "@php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
