# Application
APP_NAME=Vayu
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC

# Logging: daily | single
LOG_CHANNEL=daily

# Database
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Mail (SMTP) — move real credentials here, never commit them
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Set true to bridge legacy array-based routes (app/view.php, api/gateway.php)
VAYU_LEGACY_ROUTES=false
